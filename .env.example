# Variables for docker-compose.yml. Copy to .env in the repository root. Do NOT commit it.
#
# Module secrets (DEEPSEEK_API_KEY, KS_HTTP_TOKEN, CHIRON_ONE_SECRET…) do
# NOT go here — they live in that module's own .env, just as when running outside Docker.

# Password of the postgres user inside the container. It is part of a connection URL,
# so use URL-safe characters — generate it with: openssl rand -hex 24
POSTGRES_PASSWORD=
