# Biến cho docker-compose.yml. Sao chép thành .env ở thư mục gốc. KHÔNG commit.
#
# Secret của từng module (DEEPSEEK_API_KEY, KS_HTTP_TOKEN, CHIRON_ONE_SECRET…)
# KHÔNG đặt ở đây — chúng nằm trong .env của module đó, như khi chạy ngoài Docker.

# Mật khẩu user postgres trong container. Nó nằm trong connection URL, nên dùng
# ký tự an toàn cho URL — tạo bằng: openssl rand -hex 24
POSTGRES_PASSWORD=
