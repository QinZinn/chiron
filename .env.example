# =============================================================================
# Chiron frontend — cấu hình môi trường
# Sao chép thành .env (cùng thư mục), điền giá trị thật. KHÔNG commit .env.
# =============================================================================
#
# QUY ƯỚC
#   - Mọi biến của frontend mang tiền tố CHIRON_, gom theo nhóm:
#       CHIRON_MNEMOSYNE_*   Mnemosyne (Rust/Actix)
#       CHIRON_KS_*          Knowledge Store (Python/Flask)
#       CHIRON_ONE_*         withone.ai — cổng kết nối dịch vụ ngoài
#       CHIRON_GCAL_*        Google Calendar (đọc qua withone.ai)
#       CHIRON_*             cấu hình chung của giao diện
#   - Quy ước này CHỈ áp dụng ở tầng frontend. .env của Mnemosyne / KS / Horae
#     giữ nguyên tên biến cũ (đang chạy production, không đổi).
#
# BIẾN NÀO TỚI ĐƯỢC BROWSER?
#   Chỉ các biến đánh dấu [public] bên dưới được nhúng vào code chạy trong
#   browser (danh sách cứng trong vite.config.ts, không phải theo tiền tố).
#   Các biến [server] chỉ được Vite dev/preview server đọc — proxy gắn chúng vào
#   request phía server, nên secret không bao giờ xuất hiện trong DevTools hay
#   trong bundle build. Hệ quả: phải chạy frontend bằng `npm run dev` hoặc
#   `npm run preview`; mở thẳng file tĩnh trong dist/ thì KS và Lịch học không
#   có proxy để gọi.
#
# ÁNH XẠ SANG BIẾN CỦA CÁC MODULE (để tra cứu, frontend KHÔNG đọc các biến này)
#   CHIRON_MNEMOSYNE_URL   ↔ Mnemosyne bind cứng 127.0.0.1:8081 (main.rs)
#   CHIRON_KS_URL          ↔ KS_HTTP_PORT            (knowledgeStore/.env)
#   CHIRON_KS_TOKEN        ↔ KS_HTTP_TOKEN           (knowledgeStore/.env, Mnemosyne/.env)
#   CHIRON_GCAL_AUTO_STUDY_CALENDAR ↔ AUTO_STUDY_CALENDAR (Horae/horae/settings.py)
#   CHIRON_GCAL_IGNORED_CALENDARS   ↔ IGNORED_CALENDARS   (Horae/horae/settings.py)
#   DEEPSEEK_API_KEY / LLM_PROVIDER / KS_LLM_* — KHÔNG có bản CHIRON_: frontend
#     không gọi LLM. Mọi lời gọi LLM đi qua Mnemosyne, key nằm ở .env của nó.
#     Đặt key LLM vào đây chỉ tạo thêm một chỗ có thể lộ secret.
#   TODOIST_TOKEN — không cần: frontend không đọc Todoist.
# =============================================================================


# -----------------------------------------------------------------------------
# Mnemosyne — học bài (Socratic), thẻ ghi nhớ, quiz
# -----------------------------------------------------------------------------
# [public] Browser gọi THẲNG (cross-origin). Mnemosyne chỉ cho phép CORS từ
# http://localhost:5173 / :4173 (và 127.0.0.1 tương ứng) — frontend chạy cố định
# ở hai cổng này (strictPort). Dùng 127.0.0.1 thay cho localhost vì Mnemosyne
# chỉ bind IPv4.
CHIRON_MNEMOSYNE_URL=http://127.0.0.1:8081

# [public] UUID người học mặc định. Mnemosyne KHÔNG có auth — user_id được
# truyền trần trong request. Để trống: chọn trong Cài đặt (danh sách lấy từ
# GET /users; nếu chỉ có đúng một user thì tự chọn user đó).
CHIRON_MNEMOSYNE_USER_ID=


# -----------------------------------------------------------------------------
# Knowledge Store — mục "Kiến thức"
# -----------------------------------------------------------------------------
# [server] Địa chỉ KS. Browser KHÔNG gọi thẳng: nó gọi /api/ks/* trên Vite
# server, proxy chuyển tiếp tới đây (chỉ GET /health, /nodes, /nodes/{id}).
# Mặc định KS chạy cổng 8080 (KS_HTTP_PORT); máy nào 8080 đã bị chiếm thì đổi
# KS_HTTP_PORT bên KS và sửa cổng ở đây cho khớp.
CHIRON_KS_URL=http://127.0.0.1:8080

# [server] SECRET. Phải trùng KS_HTTP_TOKEN của KS. Proxy gắn thành header
# `Authorization: Bearer <token>`. Chỉ ký tự ASCII (KS từ chối token khác).
# Tạo mới: openssl rand -hex 32
CHIRON_KS_TOKEN=


# -----------------------------------------------------------------------------
# withone.ai — mọi kết nối dịch vụ ngoài (hiện dùng cho Google Calendar)
# -----------------------------------------------------------------------------
# [server] Gốc API của One. Proxy gọi <base>/v1/passthrough/<đường dẫn Google>.
CHIRON_ONE_API_BASE=https://api.withone.ai

# [server] SECRET. API key tài khoản One (app.withone.ai → Settings → API keys).
# Gửi dưới header x-one-secret. Để trống → Lịch học báo "chưa cấu hình".
CHIRON_ONE_SECRET=


# -----------------------------------------------------------------------------
# Google Calendar — mục "Lịch học" (CHỈ ĐỌC, qua withone.ai)
# -----------------------------------------------------------------------------
# [server] Connection key của tài khoản Google Calendar đã kết nối trong One
# (dạng live::google-calendar::default::…; xem ở app.withone.ai hoặc `one list`).
# Proxy chỉ mở hai thao tác đọc: danh sách calendar và danh sách event. Không có
# đường nào để tạo/sửa/xoá event — việc đó thuộc riêng Horae.
CHIRON_ONE_GCAL_CONNECTION_KEY=

# [public] Tên calendar chứa block tự học do Horae tạo (tiêu đề có tiền tố
# [Auto]). Phải khớp AUTO_STUDY_CALENDAR của Horae.
CHIRON_GCAL_AUTO_STUDY_CALENDAR=Auto-Study

# [public] Tên các calendar KHÔNG hiển thị, phân tách bằng dấu phẩy. Nên khớp
# IGNORED_CALENDARS của Horae (Horae/horae/settings.py).
CHIRON_GCAL_IGNORED_CALENDARS=


# -----------------------------------------------------------------------------
# Chung
# -----------------------------------------------------------------------------
# [public] Múi giờ hiển thị lịch và giờ học. Khớp preset của Horae.
CHIRON_TIMEZONE=Asia/Ho_Chi_Minh
