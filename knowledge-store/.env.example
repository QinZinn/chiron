# Sao chép thành .env, điền giá trị thật. KHÔNG commit .env.
KS_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/chiron_ks
KS_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/chiron_ks_test

# HTTP layer
KS_HTTP_TOKEN=
KS_HTTP_PORT=8080

# LLM (chỉ job định kỳ cần; hai route HTTP không chạm LLM)
KS_LLM_PROVIDER=deepseek
KS_LLM_MODEL=deepseek-v4-flash
KS_LLM_BASE_URL=https://api.deepseek.com/v1
KS_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# card_sync → Mnemosyne
KS_MNEMOSYNE_URL=http://127.0.0.1:8081
KS_MNEMOSYNE_TOKEN=
# Id study set 'KS review' bên Mnemosyne. Tạo MỘT LẦN bằng
# POST /study_sets rồi điền id trả về. KHÔNG phải tên set.
KS_CARD_SYNC_STUDY_SET_ID=
