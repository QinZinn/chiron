# Copy to .env and fill in real values. Do NOT commit .env.
KS_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/chiron_ks
KS_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/chiron_ks_test

# HTTP layer
KS_HTTP_TOKEN=
KS_HTTP_PORT=8080

# OCR service for /notes (Chiron/ocr). Empty → /notes returns 503; everything else still works.
# Outside Docker, run `python -m chiron_ocr.app` in ocr/ and set http://127.0.0.1:8866.
# Under Compose this value is overridden with http://ocr:8866.
KS_OCR_URL=

# LLM — the periodic concept-extraction job and POST /notes/{id}/extract
KS_LLM_PROVIDER=deepseek
KS_LLM_MODEL=deepseek-v4-flash
KS_LLM_BASE_URL=https://api.deepseek.com/v1
KS_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# card_sync → Mnemosyne
KS_MNEMOSYNE_URL=http://127.0.0.1:8081
KS_MNEMOSYNE_TOKEN=
# Id of the 'KS review' study set in Mnemosyne. Create it ONCE with
# POST /study_sets and fill in the returned id. NOT the set's name.
KS_CARD_SYNC_STUDY_SET_ID=
