# Job that extracts concepts from transcripts. NEEDS THE FULL SET OF LLM VARIABLES (DeepSeek).
# Type=oneshot — scheduling is systemd's job, not something to stuff into module code.

[Unit]
Description=Chiron Knowledge Store — extract concepts from transcripts
After=chiron-ks-postgres.service
Requires=chiron-ks-postgres.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/Chiron/knowledge-store
EnvironmentFile=%h/Projects/Chiron/knowledge-store/.env
ExecStart=%h/Projects/Chiron/knowledge-store/.venv/bin/python -m ks.cli extract
