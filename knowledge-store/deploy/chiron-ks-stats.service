# Daily snapshot of the instrumentation numbers. No LLM (ks stats only reads the DB),
# but it still loads .env to share one source of configuration.

[Unit]
Description=Chiron Knowledge Store — instrumentation numbers
After=chiron-ks-postgres.service
Requires=chiron-ks-postgres.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/Chiron/knowledge-store
EnvironmentFile=%h/Projects/Chiron/knowledge-store/.env
ExecStart=%h/Projects/Chiron/knowledge-store/.venv/bin/python -m ks.cli stats
