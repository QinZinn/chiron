# Chụp số liệu instrumentation hằng ngày. Không chạm LLM (ks stats chỉ đọc DB),
# nhưng vẫn nạp .env để dùng chung một nguồn cấu hình.

[Unit]
Description=Chiron Knowledge Store — số liệu instrumentation
After=chiron-ks-postgres.service
Requires=chiron-ks-postgres.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/Chiron/KnowledgeStore
EnvironmentFile=%h/Projects/Chiron/KnowledgeStore/.env
ExecStart=%h/Projects/Chiron/KnowledgeStore/.venv/bin/python -m ks.cli stats
