# HTTP layer for Mnemosyne (Rust/Actix — a different runtime, so it must go over HTTP).
#
# USER unit (~/.config/systemd/user/), not a system unit — a deliberate departure from
# brief §10. Every management command needs `--user`. Needs `loginctl enable-linger`
# to survive logout. See NOTES.md.
#
# Type=simple: `ks serve` blocks forever, it is NOT a cron job.
# The two write routes do not touch the LLM, so this unit needs NO LLM variables.
#
# TRAP: after a code change the service keeps running the OLD code until `systemctl --user
# restart chiron-ks-http`. Verifying with curl without restarting tests the old code.

[Unit]
Description=Chiron Knowledge Store — HTTP API
After=chiron-ks-postgres.service
Requires=chiron-ks-postgres.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/Chiron/knowledge-store
EnvironmentFile=%h/Projects/Chiron/knowledge-store/.env
ExecStart=%h/Projects/Chiron/knowledge-store/.venv/bin/python -m ks.cli serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
