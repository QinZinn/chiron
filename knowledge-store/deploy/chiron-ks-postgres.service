# Chiron KS's own Postgres cluster, running as a regular user (not postgres).
#
# A TRAP WE PAID FOR: the default unix_socket_directories = '/run/postgresql' (commented
# out in postgresql.conf). That directory does not exist for a regular user →
# "FATAL: could not create lock file". Change line 68 of postgresql.conf to PGDATA.
#
# The port is 5432 (initdb's default). If you see 55432 anywhere, that is the cluster from
# an earlier build — do NOT reuse it.

[Unit]
Description=Chiron Knowledge Store — Postgres
After=network.target

[Service]
Type=forking
Environment=PGDATA=%h/.local/share/chiron-ks-postgres
ExecStart=/usr/bin/pg_ctl start -D ${PGDATA} -o "-p 5432" -l ${PGDATA}/logfile -w
ExecStop=/usr/bin/pg_ctl stop -D ${PGDATA} -m fast
ExecReload=/usr/bin/pg_ctl reload -D ${PGDATA}
TimeoutStartSec=60
Restart=on-failure

[Install]
WantedBy=default.target
