# Push reviewed nodes to Mnemosyne as cards.
# USER unit — every management command needs `--user`. See NOTES.md.
#
# Does NOT touch the LLM on the KS side (Mnemosyne is the one calling the LLM), but needs
# KS_MNEMOSYNE_URL + KS_MNEMOSYNE_TOKEN in .env.
#
# Type=oneshot — scheduling is systemd's job, not something to stuff into module code.

[Unit]
Description=Chiron Knowledge Store — sync nodes to Mnemosyne cards
After=chiron-ks-postgres.service
Requires=chiron-ks-postgres.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/Chiron/knowledge-store
EnvironmentFile=%h/Projects/Chiron/knowledge-store/.env
ExecStart=%h/Projects/Chiron/knowledge-store/.venv/bin/python -m ks.cli card-sync
