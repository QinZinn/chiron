# Mnemosyne HTTP API (Rust/Actix) — studying, flashcards, quizzes.
#
# USER unit (~/.config/systemd/user/), like the Knowledge Store units: every
# management command needs `--user`, and `loginctl enable-linger` is needed to survive
# logout. See knowledgeStore/deploy/ for the same conventions.
#
# Type=simple: the server blocks forever, it is NOT a cron job.
#
# Runs the RELEASE binary, not `cargo run`: cargo needs the whole toolchain and
# the source tree at startup, whereas this needs exactly one file. Build first:
#   cd ~/Projects/Chiron/mnemosyne && cargo build --release
#
# TRAP: after a rebuild the service keeps running the OLD binary until
# `systemctl --user restart chiron-mnemosyne`.

[Unit]
Description=Chiron Mnemosyne — learning API (FSRS, Socratic, quiz)
# Same Postgres cluster as the Knowledge Store: one server, two separate databases.
After=chiron-ks-postgres.service
Requires=chiron-ks-postgres.service
# Migrations must finish before the server accepts requests.
After=chiron-mnemosyne-migrate.service
Wants=chiron-mnemosyne-migrate.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/Chiron/mnemosyne
EnvironmentFile=%h/Projects/Chiron/mnemosyne/.env
ExecStart=%h/Projects/Chiron/mnemosyne/target/release/backend
# If the server dies from a transient error (the DB just restarted) it comes back up; if it dies
# from bad configuration (missing DEEPSEEK_API_KEY) it panics at once and systemd gives up
# after StartLimit instead of looping forever.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
