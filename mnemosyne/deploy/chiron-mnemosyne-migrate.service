# Applies any missing migrations, then exits. Runs before chiron-mnemosyne.service.
#
# Type=oneshot + RemainAfterExit=yes: systemd treats it as "done" rather than
# "dead", so the server unit that depends on it is not dragged into a restart.
#
# Safe to re-run: each migration is recorded in the schema_migrations table in
# the same transaction as the migration itself, so later runs skip those already applied.

[Unit]
Description=Chiron Mnemosyne — apply database migrations
After=chiron-ks-postgres.service
Requires=chiron-ks-postgres.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Projects/Chiron/mnemosyne
EnvironmentFile=%h/Projects/Chiron/mnemosyne/.env
ExecStart=%h/Projects/Chiron/mnemosyne/target/release/backend migrate

[Install]
WantedBy=default.target
